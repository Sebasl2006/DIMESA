# Copia este archivo como ".env.local" (sin ".example") y completa los valores ahí.
# ".env.local" nunca se sube a git ni se comparte - es solo para esta máquina/servidor.

# ── Supabase (Etapa 1) ──────────────────────────────────────────────
# Project Settings → API, en tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → "service_role" (secreta, NUNCA con prefijo NEXT_PUBLIC_)
# La usa solo el servidor (admin) para operaciones que ignoran RLS si hiciera falta.
SUPABASE_SERVICE_ROLE_KEY=

# Correos autorizados para entrar a /admin, separados por coma si hay más de uno
# (ej: dueño@dimesa.com,gerente@dimesa.com). Es una segunda capa de seguridad:
# aunque alguien logre crear una cuenta de Supabase Auth (registro propio,
# cuenta filtrada, etc.), si su correo no está en esta lista no entra al panel.
ADMIN_EMAILS=

# ── PayPhone (Etapa 4 - checkout) ───────────────────────────────────
# Credenciales de tu cuenta de comercio en PayPhone (Botón de Pago / API)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# ── Resend (Etapa 4 - correo de confirmación) ───────────────────────
RESEND_API_KEY=
# Correo remitente verificado en Resend (ej: pedidos@dimesa.com.ec)
RESEND_FROM_EMAIL=

# ── WhatsApp (Etapa 1 - Reservas) ───────────────────────────────────
# Número real de Dimesa en formato internacional sin "+" ni espacios (ej: 593987654321)
NEXT_PUBLIC_WHATSAPP_NUMBER=
